# Example only. Production installer generates private values in /etc/stocklog/app.env.
STOCKLOG_SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_VALUE
STOCKLOG_HOSTS=stocklog.example.com
STOCKLOG_ORIGINS=https://stocklog.example.com
STOCKLOG_HTTPS=1
STOCKLOG_STATE=/var/lib/stocklog
STOCKLOG_DB_NAME=stocklog
STOCKLOG_DB_USER=stocklog
STOCKLOG_DB_PASSWORD=SET_SECURELY_NOT_IN_GIT
STOCKLOG_DB_HOST=localhost
STOCKLOG_AGE_RECIPIENT=SET_YOUR_RECOVERY_PUBLIC_KEY
